# Imagen de PRODUCCION del backend. Multi-stage:
#   1) build: compila y publica la API con el SDK.
#   2) runtime: imagen aspnet minima, usuario no root, lista para desplegar.
#
# Uso: docker build -f backend/Dockerfile.prod -t mht-backend:prod backend
#
# Solo se restaura y publica la API (Api, Domain, Infrastructure): los tests no entran
# en la imagen, y Dockerfile.prod.dockerignore los saca tambien del contexto de build.

# mcr.microsoft.com/dotnet/sdk:9.0
FROM mcr.microsoft.com/dotnet/sdk:9.0@sha256:d9ad72f6b3eb5d61adb158db510ae1c3098c12c92d23ab8da833418275f1c652 AS build
WORKDIR /source

COPY Directory.Build.props ./
COPY Directory.Packages.props ./
COPY MentalHealthTracker.slnx ./
COPY MentalHealthTracker.Api/MentalHealthTracker.Api.csproj MentalHealthTracker.Api/
COPY MentalHealthTracker.Domain/MentalHealthTracker.Domain.csproj MentalHealthTracker.Domain/
COPY MentalHealthTracker.Infrastructure/MentalHealthTracker.Infrastructure.csproj MentalHealthTracker.Infrastructure/

RUN dotnet restore MentalHealthTracker.Api/MentalHealthTracker.Api.csproj

COPY . .
RUN dotnet publish MentalHealthTracker.Api/MentalHealthTracker.Api.csproj \
    --configuration Release \
    --output /publish \
    --no-restore

# mcr.microsoft.com/dotnet/aspnet:9.0-alpine
FROM mcr.microsoft.com/dotnet/aspnet:11.0-alpine@sha256:d39b72ad1534fa0faf52b488bffb0762df7ba269d120f0338713d4dda2a41bf5 AS runtime
WORKDIR /app

COPY --from=build /publish /app

# Las imagenes oficiales de .NET traen el usuario de uid 1654 para ejecutar sin
# privilegios; se deja como usuario por defecto del contenedor. Nunca root.
USER 1654

ENV ASPNETCORE_URLS=http://+:3000
EXPOSE 3000

ENTRYPOINT ["dotnet", "MentalHealthTracker.Api.dll"]