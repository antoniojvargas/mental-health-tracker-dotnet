# Variables NO sensibles para la pila de produccion.
#
# Uso:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# AVISO: este archivo solo define configuracion no sensible (URLs, nombres,
# nivel de log, puerto). Los secretos NO van aqui: viven en secrets/*.txt y
# Docker los monta en /run/secrets/* dentro de los contenedores (ver
# secrets/README.md). Nunca agregues passwords ni claves en un .env.

# Base de datos: usuario y nombre. El PASSWORD va en secrets/postgres_password.txt
# y dentro del connection string de secrets/database_url.txt.
POSTGRES_USER=postgres
POSTGRES_DB=mentalhealthtracker

# Google OAuth: solo el ClientId. El ClientSecret va en
# secrets/google_client_secret.txt.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# URL publica desde la que los usuarios acceden al frontend.
FRONTEND_URL=http://localhost:8080

# Nivel de log del backend (verbose, debug, information, warning, error, fatal).
LOG_LEVEL=Information

# Puerto del host que publica el frontend (dentro del contenedor sigue en 8080).
HTTP_PORT=8080