# Imagen de PRODUCCION del frontend. Multi-stage:
#   1) build: instala dependencias y compila el bundle de Vite (vue-tsc + vite).
#   2) runtime: nginx sirviendo dist/ y proxificando /api y /hub al backend.
#
# Uso: docker build -f frontend/Dockerfile.prod -t mht-frontend:prod frontend
#
# El backend se resuelve por nombre de servicio dentro de la red de Compose;
# en otros despliegues hay que ajustar el upstream en frontend/nginx.conf.

FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html

# nginx alpine arranca como root para escribir su pid y caches; en produccion
# baja a un usuario sin privilegios. Se reubica el pid a /tmp (unico directorio
# escribible garantizado) y se cede la propiedad de lo que nginx necesita
# escribir. El puerto 8080 no es privilegiado, asi que no hacen falta
# capabilities extra para escuchar en el.
RUN sed -i 's#/run/nginx.pid#/tmp/nginx.pid#' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx /usr/share/nginx/html /etc/nginx/conf.d

USER nginx

EXPOSE 8080
