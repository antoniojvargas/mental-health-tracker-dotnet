  "components": {
    "schemas": {
      "ActivityType": {
        "enum": [
          "none",
          "walking",
          "running",
          "gym",
          "yoga",
          "cycling",
          "sports",
          "other"
        ],
        "type": "string"
      },
      "CreateDailyLogRequest": {
        "required": [
          "anxietyLevel",
          "logDate",
          "moodRating",
          "sleepDisturbances",
          "sleepHours",
          "sleepQuality",
          "socialFrequency",
          "stressLevel",
          "symptoms"
        ],
        "type": "object",
        "properties": {
          "logDate": {
            "type": "string",
            "format": "date"
          },
          "moodRating": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "anxietyLevel": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "stressLevel": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "sleepHours": {
            "maximum": 24,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "sleepQuality": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "sleepDisturbances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SleepDisturbance"
            },
            "nullable": true
          },
          "activityType": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "activityMinutes": {
            "maximum": 600,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "socialFrequency": {
            "$ref": "#/components/schemas/SocialFrequency"
          },
          "symptoms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Symptom"
            },
            "nullable": true
          },
          "notes": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DailyLogListMeta": {
        "required": [
          "from",
          "limit",
          "offset",
          "to",
          "total"
        ],
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "offset": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "DailyLogListResponse": {
        "required": [
          "data",
          "meta"
        ],
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DailyLogResponse"
            },
            "nullable": true
          },
          "meta": {
            "$ref": "#/components/schemas/DailyLogListMeta"
          }
        },
        "additionalProperties": false
      },
      "DailyLogResponse": {
        "required": [
          "anxietyLevel",
          "createdAt",
          "id",
          "logDate",
          "moodRating",
          "sleepDisturbances",
          "sleepHours",
          "sleepQuality",
          "socialFrequency",
          "stressLevel",
          "symptoms",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "logDate": {
            "type": "string",
            "format": "date"
          },
          "moodRating": {
            "type": "integer",
            "format": "int32"
          },
          "anxietyLevel": {
            "type": "integer",
            "format": "int32"
          },
          "stressLevel": {
            "type": "integer",
            "format": "int32"
          },
          "sleepHours": {
            "type": "number",
            "format": "double"
          },
          "sleepQuality": {
            "type": "integer",
            "format": "int32"
          },
          "sleepDisturbances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SleepDisturbance"
            },
            "nullable": true
          },
          "activityType": {
            "$ref": "#/components/schemas/ActivityType"
          },
          "activityMinutes": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "socialFrequency": {
            "$ref": "#/components/schemas/SocialFrequency"
          },
          "symptoms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Symptom"
            },
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorBody": {
        "required": [
          "code",
          "details",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorDetail": {
        "required": [
          "field",
          "message"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "SleepDisturbance": {
        "enum": [
          "none",
          "insomnia",
          "nightmares",
          "frequent_waking",
          "early_waking"
        ],
        "type": "string"
      },
      "SocialFrequency": {
        "enum": [
          "none",
          "rare",
          "occasional",
          "frequent",
          "daily"
        ],
        "type": "string"
      },
      "Symptom": {
        "required": [
          "severity",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/SymptomType"
          },
