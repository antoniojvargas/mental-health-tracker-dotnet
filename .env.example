# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# Luego arranca el stack: docker compose up -d
# AVISO: .env contiene secretos y está en .gitignore; nunca lo versiones.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mentalhealthtracker
POSTGRES_PORT=5432

# Backend (.NET). ConnectionStrings__Default usa el formato del .NET configuration provider
ConnectionStrings__Default=Host=localhost;Port=5432;Database=mentalhealthtracker;Username=postgres;Password=change-me
ASPNETCORE_ENVIRONMENT=Development
PORT=3000
LOG_LEVEL=Information

# Autenticación (vacío hasta configurar; no versionar valores reales)
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_PROXY_TARGET=http://localhost:3000