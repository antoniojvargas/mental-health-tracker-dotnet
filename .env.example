# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# Luego arranca el stack: docker compose up -d
# AVISO: .env contiene secretos y está en .gitignore; nunca lo versiones.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mentalhealthtracker

# Backend (.NET). Las claves con "__" usan el formato del .NET configuration provider.
# Conexion que vincula Database:ConnectionString (la que valida y usa el backend).
# En la pila E2E el override docker-compose.e2e.yml inyecta este .env al contenedor;
# dentro de la red de Compose el host debe ser `postgres`, no localhost.
Database__ConnectionString=Host=postgres;Port=5432;Database=mentalhealthtracker;Username=postgres;Password=change-me
ASPNETCORE_ENVIRONMENT=Development
LOG_LEVEL=Information

# Autenticacion (vacios hasta configurar; no versionar valores reales). Las claves
# con "__" usan el formato de separador de .NET (GoogleOAuth__ClientId -> GoogleOAuth:ClientId).
# En E2E estos valores son desechables: OAuth esta puenteado por /api/auth/test-login.
JWT_SECRET=
GoogleOAuth__ClientId=
GoogleOAuth__ClientSecret=
# Debe coincidir exactamente con una URI registrada en la consola de Google Cloud.
GoogleOAuth__RedirectUri=http://localhost:5173/api/auth/google/callback
AppUrls__FrontendUrl=http://localhost:5173